--!strict
local HudModel = require("../../../src/shared/features/reef/HudModel")
local ReefConfig = require("../../../src/shared/features/reef/ReefConfig")
local harness = require("../../harness")

local function newHud(): HudModel.HudModel
    return HudModel.new(ReefConfig.default)
end

return function(suite: harness.Harness)
    suite:test("a fresh HUD offers a cast and nothing to sell", function()
        local view = newHud():view()
        harness.equal(view.phase, "idle", "phase")
        harness.isTrue(view.showCast, "cast")
        harness.isFalse(view.showReel, "reel")
        harness.isFalse(view.sellEnabled, "sell")
        harness.equal(view.coinsText, "0", "coins")
    end)

    suite:test("the line goes idle, waiting, bite, then back to idle with a result", function()
        local hud = newHud()
        hud:castStarted()
        harness.equal(hud:view().phase, "waiting", "waiting")
        harness.isTrue(hud:view().showReel, "reel is offered while the line is out")
        hud:bite()
        harness.equal(hud:view().statusText, "Bite! Reel now", "bite text")
        hud:catchResult("minnow")
        harness.equal(hud:view().phase, "idle", "idle")
        harness.equal(hud:view().statusText, "Caught a minnow!", "caught text")
        hud:castStarted()
        hud:catchResult(nil)
        harness.equal(hud:view().statusText, "It got away. Cast again", "missed text")
    end)

    suite:test("the upgrade button shows the next price and enables when affordable", function()
        local hud = newHud()
        harness.equal(hud:view().upgradeText, "Next rod: 12 coins", "price")
        harness.isFalse(hud:view().upgradeEnabled, "poor")
        hud:setCoins(12)
        harness.isTrue(hud:view().upgradeEnabled, "affordable")
        hud:setRod(#ReefConfig.default.rods)
        harness.equal(hud:view().upgradeText, "Best rod owned", "maxed")
        harness.isFalse(hud:view().upgradeEnabled, "nothing to buy")
    end)

    suite:test("stock text, sell state and thousands grouping", function()
        local hud = newHud()
        hud:setStock(3, 10)
        hud:setCoins(1234567)
        local view = hud:view()
        harness.equal(view.stockText, "Fish 3 / 10", "stock")
        harness.isTrue(view.sellEnabled, "sell")
        harness.equal(view.coinsText, "1,234,567", "coins")
        hud:setCoins(999)
        harness.equal(hud:view().coinsText, "999", "no separator")
    end)
end
