--!strict
local FriendBoostLabel = require("../../../src/shared/features/social/FriendBoostLabel")
local SocialConfig = require("../../../src/shared/features/social/SocialConfig")
local harness = require("../../harness")

return function(suite: harness.Harness)
    suite:test("friend boost label: hidden at zero or below", function()
        harness.equal(FriendBoostLabel.text(0), nil, "zero")
        harness.equal(FriendBoostLabel.text(0.4), nil, "rounds to zero")
        harness.equal(FriendBoostLabel.text(-3), nil, "negative")
    end)
    suite:test("friend boost label: shows the rounded percent", function()
        harness.equal(FriendBoostLabel.text(10), "Friend +10%", "ten")
        harness.equal(FriendBoostLabel.text(12.6), "Friend +13%", "rounded")
    end)

    suite:test("friend boost hint: shown only while no boost is active", function()
        harness.equal(FriendBoostLabel.hint(0, 10, 50), "Friends +10% each (max 50%)", "lone")
        harness.equal(FriendBoostLabel.hint(10, 10, 50), nil, "boost active")
        harness.equal(FriendBoostLabel.hint(0, 0, 50), nil, "no per-friend value")
        harness.equal(FriendBoostLabel.hint(0.4, 7.9, 40.2), "Friends +7% each (max 40%)", "floors")
    end)
    suite:test("roster: needs two players and uses the game noun", function()
        harness.equal(FriendBoostLabel.roster(1), nil, "alone")
        harness.equal(FriendBoostLabel.roster(0), nil, "empty")
        harness.equal(FriendBoostLabel.roster(3), "3 players", "default noun")
        harness.equal(FriendBoostLabel.roster(4.9, "miners"), "4 miners", "game noun")
    end)
    suite:test("pill: boost first, hint after the tutorial, nothing during it", function()
        local config = SocialConfig.default
        local per = math.floor(config.friendBoost.perFriendPct)
        harness.equal(FriendBoostLabel.pill(10, config, false), "Friend +10%", "boost wins")
        harness.equal(FriendBoostLabel.pill(0, config, false), nil, "tutorial")
        local hint = FriendBoostLabel.pill(0, config, true)
        harness.isTrue(hint ~= nil and string.find(hint, `+{per}%`, 1, true) ~= nil, "hint")
        local free = table.clone(config)
        free.friendBoost = table.clone(config.friendBoost)
        free.friendBoost.perFriendPct = 0
        harness.equal(FriendBoostLabel.pill(0, free, true), nil, "no rule, no hint")
    end)
end
