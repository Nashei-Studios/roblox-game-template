--!strict
local EnumOrder = require("../../scripts/EnumOrder")
local harness = require("../harness")

local PRODUCT = 'export type ProductName = ("Coins100")'
local CROP = 'export type CropName = ("Wheat" | "Corn")'
local PASS = 'export type PassName = ("Vip")'

local function build(first: string, second: string, third: string): string
    return table.concat({
        "--!strict",
        "-- Types generated by Zap v0.6.29",
        first,
        second,
        third,
        "return nil",
        "",
    }, "\n")
end

-- Every ordering Zap may emit for three enums.
local function permutations(): { string }
    local all = { PRODUCT, CROP, PASS }
    local result: { string } = {}
    for i = 1, 3 do
        for j = 1, 3 do
            for k = 1, 3 do
                if i ~= j and j ~= k and i ~= k then
                    table.insert(result, build(all[i], all[j], all[k]))
                end
            end
        end
    end
    return result
end

return function(suite: harness.Harness)
    suite:test("every emitted order of three enums normalizes to the same text", function()
        local expected = build(CROP, PASS, PRODUCT)
        for index, text in permutations() do
            harness.equal(EnumOrder.normalize(text), expected, "permutation " .. index)
        end
    end)

    suite:test("five runs over the same input are identical", function()
        local input = build(PRODUCT, CROP, PASS)
        local first = EnumOrder.normalize(input)
        for run = 2, 5 do
            harness.equal(EnumOrder.normalize(input), first, "run " .. run)
        end
    end)

    suite:test("normalizing is idempotent", function()
        local once = EnumOrder.normalize(build(PRODUCT, CROP, PASS))
        harness.equal(EnumOrder.normalize(once), once, "second pass")
    end)

    suite:test("lines outside a contiguous enum block keep their place", function()
        local input = table.concat({
            "local z = 1",
            PRODUCT,
            "local a = 2",
            PASS,
            CROP,
            "export type Struct = { x: number }",
            "",
        }, "\n")
        local expected = table.concat({
            "local z = 1",
            PRODUCT,
            "local a = 2",
            CROP,
            PASS,
            "export type Struct = { x: number }",
            "",
        }, "\n")
        harness.equal(EnumOrder.normalize(input), expected)
    end)

    suite:test("struct aliases sort with the enums and keep their body together", function()
        local struct = 'export type Ore = ({\n\t["id"]: (string),\n})'
        local expected = table.concat({ CROP, struct, PASS, PRODUCT, "return nil" }, "\n")
        local first = table.concat({ PRODUCT, struct, CROP, PASS, "return nil" }, "\n")
        local second = table.concat({ PASS, CROP, PRODUCT, struct, "return nil" }, "\n")
        harness.equal(EnumOrder.normalize(first), expected, "first order")
        harness.equal(EnumOrder.normalize(second), expected, "second order")
    end)

    suite:test("text without enum aliases is returned unchanged", function()
        local input = "--!strict\nreturn nil\n"
        harness.equal(EnumOrder.normalize(input), input)
    end)
end
